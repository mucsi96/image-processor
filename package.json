{
  "name": "image-processor",
  "version": "0.0.0",
  "description": "Batch CLI that converts iPhone media (JPG, HEIC, Live Photo videos) into orientation-corrected, timestamp-named PNGs.",
  "type": "module",
  "bin": {
    "image-processor": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "p-map": "^7.0.3",
    "pino": "^9.13.1",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.18.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
